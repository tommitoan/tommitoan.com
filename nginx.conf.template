server {
  listen ${PORT};

  root /usr/share/nginx/html;
  index index.html;

  # Redirects Nginx makes itself (a missing trailing slash) stay relative, so they do not name this container's port
  # when a proxy or a TLS terminator sits in front.
  absolute_redirect off;

  # Compress text assets; the static export is mostly HTML, JS, CSS and RSC payloads (.txt).
  gzip on;
  gzip_vary on;
  gzip_comp_level 6;
  gzip_min_length 512;
  gzip_types text/plain text/css text/javascript application/javascript application/json application/xml application/manifest+json image/svg+xml;

  # The 404 page is the site's own, in the look of the Feng Shui world (Next writes it to 404.html).
  error_page 404 /404.html;

  # The blog and the About page moved to the Ba-zi site. The old addresses lead to the same content there.
  # Specific patterns first: the first matching regular expression wins.
  location ~ ^/fengshui/blog/(vi|en)/([a-z0-9-]+)/?$ {
    return 301 ${BAZI_ORIGIN}/blog/$1/$2;
  }
  location ~ ^/fengshui/blog(/.*)?$ {
    return 301 ${BAZI_ORIGIN}/blog;
  }
  location ~ ^/fengshui/about(/.*)?$ {
    return 301 ${BAZI_ORIGIN}/about;
  }

  # Build output whose file name carries a content hash never changes.
  location ^~ /_next/static/ {
    add_header Cache-Control "public, max-age=31536000, immutable" always;
    try_files $uri =404;
  }

  # Images and fonts keep their names when they change, so they are kept for a week, not forever.
  location ~* \.(?:webp|png|jpe?g|gif|svg|ico|woff2?)$ {
    add_header Cache-Control "public, max-age=604800" always;
    try_files $uri =404;
  }

  # Pages and their payloads name the hashed files above, so they are always revalidated.
  location / {
    add_header Cache-Control "no-cache" always;
    try_files $uri $uri/ $uri.html =404;
  }

  location = /404.html {
    internal;
    add_header Cache-Control "no-cache" always;
  }
}
